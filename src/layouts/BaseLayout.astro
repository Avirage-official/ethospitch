---
import Header from "../components/Header.astro";
import Atmosphere from "../components/Atmosphere.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ETHOS</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body>
    <Atmosphere />
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    background: #000; /* fallback only */
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: transparent; /* 🔑 THIS WAS THE BLOCKER */
    color: white;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    position: relative;
    z-index: 0;
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 6rem 4rem 4rem;
    position: relative;
    z-index: 1; /* content above atmosphere */
  }

  @media (max-width: 768px) {
    main {
      padding: 4rem 1.5rem 3rem;
    }
  }
</style>
<head>
  ...
  <link rel="stylesheet" href="/src/styles/motion.css" />
</head>

<script>
  // soft exit dulling (no router hacks)
  window.addEventListener("beforeunload", () => {
    document.documentElement.classList.add("is-leaving");
  });
</script>

