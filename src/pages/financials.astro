---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevenueProjectionChart from "../components/finance/RevenueProjectionChart.astro";

---

<BaseLayout>
  <section class="financials-root">

    <!-- INTRO -->
    <section class="financials-intro">
      <h1>Financial model</h1>
      <p>
        ETHOS is built for long-term durability.
        Revenue scales through system trust, not extraction.
      </p>
    </section>

    <!-- WHY NOT ADS -->
    <section class="finance-block">
      <header class="block-head">
        <h2>Why not ads first</h2>
        <p>
          Advertising optimizes for attention. ETHOS optimizes for alignment.
        </p>
      </header>

      <div class="block-body two-col">
        <div class="explain">
          <p>
            Early advertising introduces incentives that degrade trust,
            distort signal quality, and bias the system toward engagement over fit.
          </p>
          <p>
            ETHOS delays ads intentionally to preserve data integrity,
            user safety, and long-term monetization power.
          </p>
        </div>

        <div class="principles">
          <div class="principle">No attention harvesting</div>
          <div class="principle">No engagement inflation</div>
          <div class="principle">No signal distortion</div>
          <div class="principle">Higher future CPMs</div>
        </div>
      </div>
    </section>

    <!-- PRICING / BUSINESS VALUE -->
<section class="finance-block">
  <header class="block-head">
    <h2>What businesses pay for</h2>
    <p>
      ETHOS is not a discovery tool.  
      It is a decision-intelligence layer.
    </p>
  </header>

  <div class="block-body">

    <!-- CORE VALUE -->
    <div class="value-grid">
      <div class="value-card">
        <h3>Market intelligence</h3>
        <p>
          ETHOS surfaces who is present in your area,
          how they behave, and what environments they respond to.
        </p>
        <ul>
          <li>Local demand composition</li>
          <li>Behavioural clustering</li>
          <li>Temporal patterns</li>
        </ul>
      </div>

      <div class="value-card">
        <h3>Target market clarity</h3>
        <p>
          Businesses see which customer types already align —
          and which do not.
        </p>
        <ul>
          <li>High-fit vs low-fit segments</li>
          <li>Environment sensitivity signals</li>
          <li>Preference-driven filtering</li>
        </ul>
      </div>

      <div class="value-card">
        <h3>Operational insight</h3>
        <p>
          ETHOS informs decisions beyond marketing.
        </p>
        <ul>
          <li>Space design implications</li>
          <li>Experience pacing</li>
          <li>Offering alignment</li>
        </ul>
      </div>
    </div>

    <!-- PRICING LOGIC -->
    <div class="pricing-logic">
      <div class="price-box">
        <span class="tier">Business access</span>
        <span class="price">$199</span>
        <span class="period">per month</span>
        <p class="explain">
          Access to aligned demand, market signals,
          and behavioural insight within your city.
        </p>
      </div>

      <div class="price-box emphasis">
        <span class="tier">Annual access</span>
        <span class="price">$1,999</span>
        <span class="period">per year</span>
        <p class="explain">
          Reduced effective rate.
          Stronger signal continuity.
          Higher data resolution.
        </p>
      </div>
    </div>

    <!-- FOOTNOTE -->
    <p class="pricing-note">
      Businesses are not paying for reach.
      They are paying to make better decisions with less noise.
    </p>

  </div>
</section>

<style>
/* VALUE GRID */
.value-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
  gap: 1.6rem;
  margin-top: 2.5rem;
}

.value-card {
  padding: 1.6rem;
  border-radius: 18px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(120,170,255,0.18);
}

.value-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.6rem;
}

.value-card p {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.75);
  margin-bottom: 1rem;
}

.value-card ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.value-card li {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.65);
  margin-bottom: 0.4rem;
}

/* PRICING */
.pricing-logic {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 1.5rem;
  margin-top: 4rem;
}

.price-box {
  padding: 2rem;
  border-radius: 22px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(120,170,255,0.25);
}

.price-box.emphasis {
  border-color: rgba(120,170,255,0.55);
}

.tier {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
}

.price {
  font-size: 2.4rem;
  font-weight: 500;
  margin: 0.4rem 0;
}

.period {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.6);
}

.explain {
  margin-top: 1rem;
  font-size: 0.9rem;
  color: rgba(255,255,255,0.75);
}

/* NOTE */
.pricing-note {
  margin-top: 3rem;
  max-width: 640px;
  font-size: 0.9rem;
  color: rgba(255,255,255,0.6);
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .pricing-logic {
    grid-template-columns: 1fr;
  }
}
</style>


    <!-- PROJECTIONS -->
    <section class="finance-block">
      <header class="block-head">
        <h2>Revenue projections</h2>
        <p>
          Conservative growth. City-by-city expansion.
        </p>
      </header>
<RevenueProjectionChart />

      <div class="chart-wrap">
        <div class="bar-chart">
          <div class="bar y1" style="--h:25%">
            <span class="label">Y1</span>
            <span class="value">$150k</span>
          </div>
          <div class="bar y2" style="--h:55%">
            <span class="label">Y2</span>
            <span class="value">$600k</span>
          </div>
          <div class="bar y3" style="--h:90%">
            <span class="label">Y3</span>
            <span class="value">$1.7M</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SCENARIOS -->
    <section class="finance-block">
      <header class="block-head">
        <h2>Scenario modeling</h2>
        <p>
          Downside, base, and upside outcomes.
        </p>
      </header>

      <div class="scenario-grid">
        <div class="scenario">
          <span class="case">Downside</span>
          <span class="amount">$800k ARR</span>
          <p>Slower onboarding, fewer cities</p>
        </div>
        <div class="scenario base">
          <span class="case">Base case</span>
          <span class="amount">$1.7M ARR</span>
          <p>Planned city rollout</p>
        </div>
        <div class="scenario">
          <span class="case">Upside</span>
          <span class="amount">$3.5M ARR</span>
          <p>High density & retention</p>
        </div>
      </div>
    </section>

    <!-- COSTS -->
    <section class="finance-block">
      <header class="block-head">
        <h2>Cost structure</h2>
        <p>
          Capital efficiency is designed, not optimized later.
        </p>
      </header>

      <div class="cost-bars">
        <div class="cost">
          <span>Infrastructure</span>
          <div class="track"><div class="fill" style="width:20%"></div></div>
        </div>
        <div class="cost">
          <span>Product & research</span>
          <div class="track"><div class="fill" style="width:45%"></div></div>
        </div>
        <div class="cost">
          <span>Operations</span>
          <div class="track"><div class="fill" style="width:15%"></div></div>
        </div>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="finance-close">
      <p>
        ETHOS prioritizes trust, signal integrity,
        and long-term platform power.
      </p>
    </section>

  </section>
</BaseLayout>

<style>
.financials-root {
  padding: 6rem 1.5rem 10rem;
}

/* INTRO */
.financials-intro {
  max-width: 760px;
  margin: 0 auto 6rem;
  text-align: center;
}
.financials-intro h1 {
  font-size: 3rem;
  letter-spacing: -0.03em;
}
.financials-intro p {
  color: rgba(255,255,255,0.7);
}

/* BLOCKS */
.finance-block {
  max-width: 900px;
  margin: 0 auto 6rem;
}
.block-head h2 {
  font-size: 1.8rem;
}
.block-head p {
  color: rgba(255,255,255,0.7);
}

/* WHY ADS */
.two-col {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 2rem;
}
.principles {
  display: grid;
  gap: 0.6rem;
}
.principle {
  padding: 0.8rem;
  border-radius: 10px;
  background: rgba(255,255,255,0.05);
}

/* PRICING */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 1.5rem;
}
.price-card {
  padding: 1.5rem;
  border-radius: 20px;
  border: 1px solid rgba(120,170,255,0.2);
  background: rgba(255,255,255,0.05);
}
.price-card.highlight {
  border-color: rgba(120,170,255,0.6);
}
.price {
  font-size: 2.2rem;
}
.period {
  color: rgba(255,255,255,0.6);
}

/* CHART */
.chart-wrap {
  margin-top: 3rem;
}
.bar-chart {
  display: flex;
  gap: 2rem;
  align-items: flex-end;
  height: 260px;
}
.bar {
  flex: 1;
  position: relative;
}
.bar::before {
  content: "";
  position: absolute;
  bottom: 0;
  width: 100%;
  height: var(--h);
  background: linear-gradient(180deg,#7aa7ff,#4f7cff);
  border-radius: 12px;
  animation: grow 1.4s ease forwards;
}
.bar span {
  position: absolute;
  bottom: -2.5rem;
  width: 100%;
  text-align: center;
}
.bar .value {
  bottom: auto;
  top: -2rem;
}

@keyframes grow {
  from { height: 0; }
}

/* SCENARIOS */
.scenario-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 1.5rem;
}
.scenario {
  padding: 1.2rem;
  border-radius: 16px;
  background: rgba(255,255,255,0.05);
}
.scenario.base {
  border: 1px solid rgba(120,170,255,0.5);
}
.case {
  font-weight: 500;
}

/* COSTS */
.cost-bars {
  display: grid;
  gap: 1.2rem;
}
.track {
  height: 8px;
  background: rgba(255,255,255,0.1);
  border-radius: 999px;
}
.fill {
  height: 100%;
  background: linear-gradient(90deg,#7aa7ff,#4f7cff);
  border-radius: 999px;
}

/* CLOSE */
.finance-close {
  text-align: center;
  max-width: 600px;
  margin: 0 auto;
  color: rgba(255,255,255,0.7);
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .two-col,
  .pricing-grid,
  .scenario-grid {
    grid-template-columns: 1fr;
  }
}
</style>
