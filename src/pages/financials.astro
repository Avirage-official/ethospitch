---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="
    max-width: 760px;
    padding-top: 4rem;
  ">
    <h1 style="
      font-size: 2.4rem;
      letter-spacing: -0.025em;
      margin-bottom: 1.5rem;
    ">
      Financials.
    </h1>

    <p style="
      font-size: 0.95rem;
      color: var(--text-secondary);
      max-width: 640px;
      margin-bottom: 3rem;
    ">
      High-level structure. No projections theatre.
    </p>

    <table style="
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    ">
      <tbody>
        <tr>
          <td style="padding: 0.75rem 0; font-weight: 500;">Revenue</td>
          <td style="padding: 0.75rem 0; color: var(--text-secondary);">
            Aligned business subscriptions
          </td>
        </tr>

        <tr>
          <td style="padding: 0.75rem 0; font-weight: 500;">Costs</td>
          <td style="padding: 0.75rem 0; color: var(--text-secondary);">
            Infrastructure, product, research
          </td>
        </tr>

        <tr>
          <td style="padding: 0.75rem 0; font-weight: 500;">Margins</td>
          <td style="padding: 0.75rem 0; color: var(--text-secondary);">
            Software-driven, high operating leverage
          </td>
        </tr>

        <tr>
          <td style="padding: 0.75rem 0; font-weight: 500;">Use of funds</td>
          <td style="padding: 0.75rem 0; color: var(--text-secondary);">
            Signal density, system depth, product quality
          </td>
        </tr>
      </tbody>
    </table>
  </section>
</BaseLayout>
