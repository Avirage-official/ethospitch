---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="max-width: 760px;">
    <h1 style="
      font-size: 2.4rem;
      letter-spacing: -0.025em;
      margin-bottom: 1.25rem;
    ">
      Why ETHOS exists.
    </h1>

    <p style="
      font-size: 1.05rem;
      line-height: 1.65;
      color: #555;
      max-width: 680px;
      margin-bottom: 2rem;
    ">
      Modern systems help people choose faster.
      They rarely help people choose better.
    </p>

    <p style="
      font-size: 1.05rem;
      line-height: 1.65;
      color: #555;
      max-width: 680px;
    ">
      ETHOS exists to restore direction — by putting identity
      before algorithms, and clarity before scale.
    </p>
  </section>
</BaseLayout>
