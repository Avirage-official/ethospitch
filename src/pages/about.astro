---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="about-root">
    <!-- BACKDROP -->
    <div class="about-backdrop" aria-hidden="true">
      <div class="orb o1"></div>
      <div class="orb o2"></div>
      <div class="orb o3"></div>
      <div class="grid"></div>
      <div class="vignette"></div>
      <div class="pointer" id="pointerGlow"></div>
    </div>

    <!-- HERO -->
    <header class="about-hero">
      <div class="hero-top" data-reveal>
        <span class="badge">ABOUT ETHOS</span>
        <span class="rule"></span>
        <span class="meta">Identity-first • Proof-gated • Anti-extraction</span>
      </div>

      <h1 class="hero-title" data-reveal>
        Why ETHOS exists
      </h1>

      <p class="hero-lede" data-reveal>
        Modern systems help people choose faster.<br />
        They rarely help people choose better.
      </p>

      <div class="hero-actions" data-reveal>
        <a class="btn primary" href="/discovery">Start discovery</a>
        <a class="btn" href="/deck">View investor deck</a>
      </div>

      <div class="hero-sub" data-reveal>
        <div class="hero-chip">
          <span class="dot"></span>
          <span>ETHOS is built to preserve signal integrity as it scales.</span>
        </div>
      </div>
    </header>

    <!-- THESIS -->
    <section class="about-section">
      <div class="section-head" data-reveal>
        <h2>The thesis</h2>
        <p>
          When choice expands faster than clarity, people don't become free — they become fragmented.
        </p>
      </div>

      <div class="thesis-field" id="thesisField">
        <svg class="thesis-svg" viewBox="0 0 1000 680" preserveAspectRatio="none" aria-hidden="true">
          <path
            id="thesisBase"
            d="M120 110 C310 40, 420 90, 500 160
               C620 270, 710 250, 880 330
               C760 420, 640 410, 520 480
               C380 560, 260 560, 120 610"
            class="thesis-base"
            fill="none"
          />
          <path
            id="thesisGlow"
            d="M120 110 C310 40, 420 90, 500 160
               C620 270, 710 250, 880 330
               C760 420, 640 410, 520 480
               C380 560, 260 560, 120 610"
            class="thesis-glow"
            fill="none"
          />
        </svg>

        <article class="thought t1" data-reveal data-node="140 120">
          <span class="kicker">01</span>
          <h3>Choice without clarity</h3>
          <p>Choice expands faster than people can interpret themselves.</p>
        </article>

        <article class="thought t2" data-reveal data-node="850 320">
          <span class="kicker">02</span>
          <h3>Noise fragments identity</h3>
          <p>When everything is possible, identity becomes unstable and performative.</p>
        </article>

        <article class="thought t3" data-reveal data-node="520 510">
          <span class="kicker">03</span>
          <h3>Misalignment becomes default</h3>
          <p>
            Fragmented identity leads to misalignment — in work, relationships,
            environments, and life direction.
          </p>
        </article>

        <article class="thought t4" data-reveal data-node="150 610">
          <span class="kicker">04</span>
          <h3>Systems optimize the wrong thing</h3>
          <p>Engagement loops reward attention, not fit. ETHOS refuses that incentive.</p>
        </article>

        <svg class="node-svg" viewBox="0 0 1000 680" preserveAspectRatio="none" aria-hidden="true">
          <g id="thesisNodes"></g>
        </svg>
      </div>
    </section>

    <!-- CORE -->
    <section class="about-section">
      <div class="section-head" data-reveal>
        <h2>What ETHOS is</h2>
        <p>
          ETHOS is not a content platform. It is a decision-intelligence layer that preserves signal,
          reduces noise, and increases alignment.
        </p>
      </div>

      <div class="bento">
        <article class="card wide" data-reveal>
          <div class="card-head">
            <span class="pill">SYSTEM</span>
            <h3>Identity before algorithms</h3>
          </div>
          <p class="muted">
            ETHOS builds a stable identity signal first, then uses that signal to power discovery,
            social fit, and marketplace alignment — without ranking people or harvesting attention.
          </p>

          <div class="diagram">
            <div class="diag-row">
              <span class="d">Identity signal</span>
              <span class="arrow">→</span>
              <span class="d">Context engine</span>
              <span class="arrow">→</span>
              <span class="d">Aligned surfaces</span>
            </div>
            <div class="diag-sub">
              discovery • people • places • experiences • work environments
            </div>
          </div>
        </article>

        <article class="card" data-reveal>
          <div class="card-head">
            <span class="pill">DESIGN</span>
            <h3>Anti-extraction by default</h3>
          </div>
          <ul class="list">
            <li>No attention harvesting</li>
            <li>No ranking identity</li>
            <li>No urgency mechanics</li>
            <li>No ad incentives early</li>
          </ul>
        </article>

        <article class="card" data-reveal>
          <div class="card-head">
            <span class="pill">VALUE</span>
            <h3>Clarity compounds</h3>
          </div>
          <p class="muted">
            As signal becomes more stable across time and context,
            ETHOS becomes more useful — without becoming more manipulative.
          </p>
          <div class="mini-metrics">
            <div class="mini">
              <span class="mini-k">Signal</span>
              <span class="mini-v">↑ stability</span>
            </div>
            <div class="mini">
              <span class="mini-k">Noise</span>
              <span class="mini-v">↓ friction</span>
            </div>
            <div class="mini">
              <span class="mini-k">Fit</span>
              <span class="mini-v">↑ decisions</span>
            </div>
          </div>
        </article>

        <article class="card" data-reveal>
          <div class="card-head">
            <span class="pill">WEDGE</span>
            <h3>Experiences produce proof</h3>
          </div>
          <p class="muted">
            Experiences validate alignment faster than content.
            ETHOS uses the marketplace as an evidence loop — not a growth hack.
          </p>
          <div class="callout">
            Proof-gated expansion, city by city.
          </div>
        </article>
      </div>
    </section>

    <!-- PROOF OF PULL -->
    <section class="about-section">
      <div class="section-head" data-reveal>
        <h2>Why people want this to exist</h2>
        <p>
          Before using ETHOS, we asked people and businesses if this system should exist at all.
        </p>
      </div>

      <div class="proof-tabs" data-reveal>
        <div class="tab-controls">
          <button class="tab-btn active" data-tab="people">People</button>
          <button class="tab-btn" data-tab="businesses">Businesses</button>
        </div>

        <div class="tab-content active" data-content="people">
          <div class="feedback-list">
            <blockquote>"I spend a lot of time comparing options because I’m scared of choosing the wrong thing."</blockquote>
            <blockquote>"This explains why most platforms exhaust me."</blockquote>
            <blockquote>"I don't need more options — I need better alignment."</blockquote>
          </div>
          <span class="feedback-label">Early user feedback</span>
        </div>

        <div class="tab-content" data-content="businesses">
          <div class="feedback-list">
            <blockquote>"I don't want more leads. I want the right ones."</blockquote>
            <blockquote>"This feels like positioning without marketing language."</blockquote>
            <blockquote>"We waste time filtering instead of building."</blockquote>
          </div>
          <span class="feedback-label">Business operator feedback</span>
        </div>
      </div>

      <div class="proof-cta" data-reveal>
        <p class="cta-intro">If this resonates, you can add your perspective.</p>
        <div class="cta-row">
          <button class="btn secondary">Share user feedback</button>
          <button class="btn secondary">Share business feedback</button>
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="about-section">
      <div class="section-head" data-reveal>
        <h2>Non-negotiables</h2>
        <p>These are constraints — not slogans. They keep ETHOS durable.</p>
      </div>

      <div class="principles">
        <article class="p" data-reveal>
          <h3>Signal integrity</h3>
          <p>We protect identity signal from distortion as density increases.</p>
        </article>
        <article class="p" data-reveal>
          <h3>No identity ranking</h3>
          <p>ETHOS never turns personality into a leaderboard or social currency.</p>
        </article>
        <article class="p" data-reveal>
          <h3>Proof before scale</h3>
          <p>Expansion is gated by stability, retention, and measurable clarity.</p>
        </article>
        <article class="p" data-reveal>
          <h3>Privacy-first</h3>
          <p>Minimization, safe defaults, and permissioned portability.</p>
        </article>
        <article class="p" data-reveal>
          <h3>Anti-urgency UX</h3>
          <p>No scarcity, no streaks, no coercive loops. Calm by design.</p>
        </article>
        <article class="p" data-reveal>
          <h3>Explainability</h3>
          <p>Outputs must be interpretable — direction, not black-box verdicts.</p>
        </article>
      </div>
    </section>

    <!-- HOW WE PROVE -->
    <section class="about-section">
      <div class="section-head" data-reveal>
        <h2>How ETHOS earns trust</h2>
        <p>
          Professionals don't fund narratives — they fund systems that can prove integrity and scale.
        </p>
      </div>

      <div class="proof-grid">
        <article class="proof" data-reveal>
          <span class="proof-tag">VALIDATION</span>
          <h3>Stability over time</h3>
          <p class="muted">
            Test–retest reliability + confidence calibration.
            We measure stability across repetition and context changes.
          </p>
          <div class="proof-line">
            <span class="k">Target</span>
            <span class="v">repeatable signal</span>
          </div>
        </article>

        <article class="proof" data-reveal>
          <span class="proof-tag">DENSITY</span>
          <h3>Clarity at scale</h3>
          <p class="muted">
            Density must increase without ranking, manipulation, or signal collapse.
            City rollout is designed as independent ecosystems.
          </p>
          <div class="proof-line">
            <span class="k">Target</span>
            <span class="v">no distortion</span>
          </div>
        </article>

        <article class="proof" data-reveal>
          <span class="proof-tag">GOVERNANCE</span>
          <h3>Ethical intelligence</h3>
          <p class="muted">
            Drift monitoring, bias checks, auditability.
            If ML improves performance but harms ethics, it fails.
          </p>
          <div class="proof-line">
            <span class="k">Target</span>
            <span class="v">trust preserved</span>
          </div>
        </article>
      </div>

      <div class="proof-banner" data-reveal>
        <div class="pb-left">
          <h3>ETHOS exists to reverse misalignment.</h3>
          <p>
            By placing identity before algorithms,
            structure before scale,
            and alignment before engagement.
          </p>
        </div>
        <div class="pb-right">
          <div class="pb-chip">Proof-gated roadmap</div>
          <div class="pb-chip">Business intelligence wedge</div>
          <div class="pb-chip">City compounding model</div>
          <div class="pb-chip">Anti-extraction UX</div>
        </div>
      </div>
    </section>

    <!-- CLOSING -->
    <section class="about-close" data-reveal>
      <h2>What this becomes</h2>
      <p>
        ETHOS is not a platform.<br />
        It is an identity system for navigating a complex world.
      </p>
      <div class="close-actions">
        <a class="btn primary" href="/roadmap">See the roadmap</a>
        <a class="btn" href="/financials">View financial model</a>
      </div>
    </section>
  </section>

  <script is:inline>
    (() => {
      // reveal
      const els = Array.from(document.querySelectorAll("[data-reveal]"));
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) e.target.classList.add("is-in");
          }
        },
        { threshold: 0.18, rootMargin: "0px 0px -10% 0px" }
      );
      els.forEach((el) => io.observe(el));

      // pointer glow
      const glow = document.getElementById("pointerGlow");
      let gx = 0, gy = 0, tx = 0, ty = 0, raf = 0;

      function tick() {
        raf = 0;
        gx += (tx - gx) * 0.12;
        gy += (ty - gy) * 0.12;
        glow.style.transform = `translate(${gx}px, ${gy}px) translate(-50%, -50%)`;
      }

      window.addEventListener("pointermove", (e) => {
        const r = document.documentElement.getBoundingClientRect();
        tx = e.clientX - r.left;
        ty = e.clientY - r.top;
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });

      // thesis nodes
      const nodesG = document.getElementById("thesisNodes");
      const field = document.getElementById("thesisField");
      if (nodesG && field) {
        const svg = field.querySelector(".node-svg");
        const cards = Array.from(field.querySelectorAll("[data-node]"));
        const clamp = (n,a,b)=>Math.max(a,Math.min(b,n));

        function clear(n){ while(n.firstChild) n.removeChild(n.firstChild); }
        function el(tag, attrs = {}) {
          const n = document.createElementNS("http://www.w3.org/2000/svg", tag);
          Object.entries(attrs).forEach(([k, v]) => n.setAttribute(k, String(v)));
          return n;
        }

        function build() {
          clear(nodesG);
          const pts = cards.map((c) => {
            const [x,y] = (c.getAttribute("data-node") || "0 0").split(" ").map(Number);
            return { x, y };
          });

          // connectors between nodes (soft)
          for (let i = 0; i < pts.length - 1; i++) {
            const a = pts[i], b = pts[i+1];
            nodesG.appendChild(el("path", {
              d: `M ${a.x} ${a.y} C ${(a.x+b.x)/2} ${a.y-26}, ${(a.x+b.x)/2} ${b.y+26}, ${b.x} ${b.y}`,
              class: "node-conn"
            }));
          }

          // nodes
          pts.forEach((p) => {
            nodesG.appendChild(el("circle", { cx: p.x, cy: p.y, r: 13, class: "node-ring" }));
            nodesG.appendChild(el("circle", { cx: p.x, cy: p.y, r: 4.8, class: "node-dot" }));
          });

          // animate glow stroke length once visible
          const glowPath = document.getElementById("thesisGlow");
          if (glowPath) {
            const len = glowPath.getTotalLength();
            glowPath.style.strokeDasharray = String(len);
            glowPath.style.strokeDashoffset = String(len);
            requestAnimationFrame(() => {
              glowPath.classList.add("draw");
              glowPath.style.strokeDashoffset = "0";
            });
          }
        }

        build();
        new ResizeObserver(build).observe(field);
      }

      // tab functionality
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          
          btn.classList.add('active');
          document.querySelector(`[data-content="${tab}"]`)?.classList.add('active');
        });
      });
    })();
  </script>

  <style>
    /* ROOT */
    .about-root {
      position: relative;
      padding: 7.5rem 1.5rem 12rem;
      overflow: clip;
    }

    /* BACKDROP */
    .about-backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .orb {
      position: absolute;
      width: 760px;
      height: 760px;
      border-radius: 999px;
      filter: blur(80px);
      opacity: 0.18;
      transform: translate3d(0,0,0);
      animation: float 18s ease-in-out infinite alternate;
    }
    .o1 { left: -240px; top: -280px; background: radial-gradient(circle at 35% 35%, rgba(120,170,255,0.85), transparent 60%); }
    .o2 { right: -260px; top: 240px; background: radial-gradient(circle at 55% 45%, rgba(120,255,210,0.70), transparent 60%); animation-delay: 3s; }
    .o3 { left: 10%; bottom: -420px; background: radial-gradient(circle at 55% 45%, rgba(190,140,255,0.75), transparent 60%); animation-delay: 6s; }

    .grid {
      position: absolute;
      inset: -2px;
      opacity: 0.08;
      background-image:
        linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(circle at 50% 25%, rgba(0,0,0,0.9), rgba(0,0,0,0.05) 70%);
    }

    .vignette {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 20%, rgba(0,0,0,0.0), rgba(0,0,0,0.55) 72%, rgba(0,0,0,0.78) 100%);
    }

    .pointer {
      position: absolute;
      width: 520px;
      height: 520px;
      border-radius: 999px;
      background: radial-gradient(circle at 50% 50%, rgba(120,170,255,0.20), rgba(120,170,255,0.06), transparent 62%);
      filter: blur(18px);
      opacity: 0.75;
      left: 0;
      top: 0;
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
    }

    @keyframes float {
      from { transform: translateY(-14px) translateX(-10px) scale(1); }
      to { transform: translateY(14px) translateX(10px) scale(1.02); }
    }

    /* HERO */
    .about-hero {
      position: relative;
      z-index: 1;
      max-width: 920px;
      margin: 0 auto 7.5rem;
      text-align: center;
    }

    .hero-top {
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.7rem;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 800ms ease, transform 800ms ease;
    }

    .badge {
      font-size: 0.74rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(120,170,255,0.85);
      padding: 0.5rem 0.75rem;
      border-radius: 999px;
      border: 1px solid rgba(120,170,255,0.20);
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(14px);
    }

    .rule {
      width: 60px;
      height: 1px;
      background: rgba(255,255,255,0.14);
    }

    .meta {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.62);
    }

    .hero-title {
      font-size: clamp(2.8rem, 4vw, 3.6rem);
      letter-spacing: -0.035em;
      margin: 0 0 1.2rem;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 900ms ease, transform 900ms ease;
    }

    .hero-lede {
      font-size: 1.15rem;
      line-height: 1.65;
      color: rgba(255,255,255,0.76);
      margin: 0 auto 2.2rem;
      max-width: 58ch;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 900ms ease, transform 900ms ease;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 0.9rem;
      flex-wrap: wrap;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 900ms ease, transform 900ms ease;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.95rem 1.15rem;
      border-radius: 14px;
      border: 1px solid rgba(120,170,255,0.22);
      background: rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      backdrop-filter: blur(16px);
      transition: transform 180ms ease, border-color 220ms ease, background 220ms ease;
      min-width: 170px;
    }
    .btn:hover { transform: translateY(-2px); border-color: rgba(120,170,255,0.42); background: rgba(255,255,255,0.06); }
    .btn.primary {
      border-color: rgba(120,170,255,0.46);
      background: linear-gradient(180deg, rgba(120,170,255,0.14), rgba(255,255,255,0.04));
      box-shadow: 0 0 0 1px rgba(120,170,255,0.12), 0 18px 60px rgba(0,0,0,0.55);
    }
    .btn.secondary {
      border: 1px solid rgba(120,170,255,0.22);
      background: rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.85);
    }
    .btn.secondary:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(120,170,255,0.32);
    }

    .hero-sub {
      margin-top: 2.2rem;
      display: flex;
      justify-content: center;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 900ms ease, transform 900ms ease;
    }

    .hero-chip {
      display: inline-flex;
      gap: 0.65rem;
      align-items: center;
      padding: 0.85rem 1.05rem;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(0,0,0,0.18);
      color: rgba(255,255,255,0.68);
      backdrop-filter: blur(16px);
      max-width: 760px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(120,170,255,0.95);
      box-shadow: 0 0 18px rgba(120,170,255,0.9);
    }

    /* SECTIONS */
    .about-section {
      position: relative;
      z-index: 1;
      max-width: 1120px;
      margin: 0 auto 6.5rem;
    }

    .section-head {
      max-width: 780px;
      margin: 0 auto 2.4rem;
      text-align: center;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 850ms ease, transform 850ms ease;
    }

    .section-head h2 {
      font-size: 2.0rem;
      letter-spacing: -0.02em;
      margin: 0 0 0.8rem;
    }

    .section-head p {
      margin: 0;
      color: rgba(255,255,255,0.72);
      line-height: 1.7;
    }

    /* THESIS FIELD */
    .thesis-field {
      position: relative;
      height: 720px;
      border-radius: 34px;
      border: 1px solid rgba(120,170,255,0.14);
      background: rgba(255,255,255,0.02);
      overflow: hidden;
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 70px rgba(0,0,0,0.55);
    }

    .thesis-svg,
    .node-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.95;
    }

    .thesis-base {
      stroke: rgba(120,170,255,0.18);
      stroke-width: 2;
      stroke-dasharray: 6 10;
      opacity: 0.75;
    }

    .thesis-glow {
      stroke: rgba(120,170,255,0.92);
      stroke-width: 3;
      filter: drop-shadow(0 0 18px rgba(120,170,255,0.9));
      opacity: 0.0;
      transition: opacity 600ms ease;
    }
    .thesis-glow.draw {
      opacity: 0.9;
      transition: opacity 600ms ease, stroke-dashoffset 1400ms ease;
      transition-delay: 80ms;
    }

    .node-conn {
      fill: none;
      stroke: rgba(120,170,255,0.20);
      stroke-width: 2;
      filter: drop-shadow(0 0 10px rgba(120,170,255,0.25));
      opacity: 0.85;
    }

    .node-ring {
      fill: rgba(120,170,255,0.06);
      stroke: rgba(120,170,255,0.32);
      stroke-width: 1;
      filter: drop-shadow(0 0 16px rgba(120,170,255,0.40));
      opacity: 0.95;
    }

    .node-dot {
      fill: rgba(255,255,255,0.86);
      filter: drop-shadow(0 0 10px rgba(120,170,255,0.65));
