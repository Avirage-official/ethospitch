---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeedbackForm from '~/components/widgets/FeedbackForm.astro';
---

<BaseLayout>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-inner">
    <h1>
      Identity,<br />
      before algorithms.
    </h1>

    <p class="hero-sub">
      ETHOS is a directional system for understanding who you are —
      so decisions across life align and compound.
    </p>

    <div class="hero-ctas">
      <a
        href="https://discover.ethos-official.com"
        class="cta primary"
        target="_blank"
        rel="noopener"
      >
        Discover your identity
      </a>

      <a
        href="https://app.ethos-official.com"
        class="cta ghost"
        target="_blank"
        rel="noopener"
      >
        Open the app
      </a>
    </div>

    <!-- SYSTEM LINE -->
    <div class="system-line">
      <span>Identity</span>
      <span class="arrow">→</span>
      <span>Signal</span>
      <span class="arrow">→</span>
      <span>Direction</span>
    </div>
  </div>
</section>

<!-- TRANSITION STATEMENT -->
<section class="transition">
  <p>
    Most systems help you choose faster.<br />
    ETHOS helps you choose better.
  </p>
</section>

<!-- PROOF OF PULL -->
<section class="proof-pull">
  <div class="proof-inner">
    <h2 class="proof-title">Why people want this to exist</h2>
    <p class="proof-intro">
      Before using ETHOS, we asked people and businesses if this system should exist at all.
    </p>

    <div class="proof-tabs">
      <div class="tab-controls">
        <button class="tab-btn active" data-tab="people">People</button>
        <button class="tab-btn" data-tab="businesses">Businesses</button>
      </div>

      <div class="tab-content active" data-content="people">
        <div class="feedback-list">
          <blockquote>"I spend a lot of time comparing options because I’m scared of choosing the wrong thing."</blockquote>
          <blockquote>"This explains why most platforms exhaust me."</blockquote>
          <blockquote>"Everything claims to be personalised, but I still don’t understand why I’m seeing what I see."</blockquote>
        </div>
        <span class="feedback-label">Early user feedback</span>
      </div>

      <div class="tab-content" data-content="businesses">
        <div class="feedback-list">
          <blockquote>"I don't want more leads. I want the right ones."</blockquote>
          <blockquote>"This feels like positioning without marketing language."</blockquote>
          <blockquote>"We waste time filtering instead of building."</blockquote>
        </div>
        <span class="feedback-label">Business operator feedback</span>
      </div>
    </div>
    <FeedbackForm />
  </div>
</section>

<!-- EXPERIENCE GATEWAYS -->
<section class="gateways">
  <div class="gateway">
    <h3>For individuals</h3>
    <p>
      Understand how you experience the world —
      and why certain paths consistently fit better than others.
    </p>

    <a
      href="https://discover.ethos-official.com"
      class="cta secondary"
      target="_blank"
      rel="noopener"
    >
      Start discovery →
    </a>
  </div>

  <div class="gateway">
    <h3>For builders & investors</h3>
    <p>
      Explore the system, economics, and long-term thinking
      behind ETHOS.
    </p>

    <a href="/deck" class="cta secondary">
      View the deck →
    </a>
  </div>
</section>

<!-- QUOTE -->
<section class="quote">
  <p>
    "It's not about saving time.<br />
    It's about never wasting it."
  </p>
</section>

<!-- FOOTER CTA -->
<section class="final">
  <h2>
    Built for alignment.<br />
    Designed to compound.
  </h2>

  <p>
    ETHOS is not a platform.<br />
    It is an identity system for navigating a complex world.
  </p>

  <a href="/deck" class="cta primary">
    Explore the system →
  </a>
</section>

</BaseLayout>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;

      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

      btn.classList.add('active');
      document.querySelector(`[data-content="${tab}"]`)?.classList.add('active');
    });
  });
</script>

<style>
/* ---------- GLOBAL ---------- */

:global(body) {
  background:
    radial-gradient(
      60% 45% at 50% 0%,
      rgba(120,170,255,0.08),
      rgba(0,0,0,0) 70%
    ),
    #000;
}

/* ---------- HERO ---------- */

.hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: -20%;
  background:
    radial-gradient(
      35% 35% at 50% 30%,
      rgba(120,170,255,0.22),
      rgba(0,0,0,0) 70%
    );
  filter: blur(120px);
  animation: drift 22s ease-in-out infinite alternate;
}

@keyframes drift {
  from { transform: translateY(-12px); }
  to { transform: translateY(12px); }
}

.hero-inner {
  position: relative;
  max-width: 820px;
  padding: 0 1.5rem;
  text-align: center;
  z-index: 1;
}

.hero h1 {
  font-size: clamp(3.6rem, 6vw, 5rem);
  line-height: 1.02;
  letter-spacing: -0.03em;
  margin-bottom: 1.8rem;
}

.hero-sub {
  max-width: 600px;
  margin: 0 auto 3.5rem;
  font-size: 1.15rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.72);
}

/* ---------- CTA ---------- */

.hero-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 4.5rem;
}

.cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 1.4rem;
  border-radius: 999px;
  font-size: 0.95rem;
  font-weight: 500;
  transition: transform 160ms ease, opacity 160ms ease, background 160ms ease;
}

.cta.primary {
  background: #fff;
  color: #000;
}

.cta.primary:hover {
  transform: translateY(-1px);
  opacity: 0.92;
}

.cta.ghost {
  background: rgba(255,255,255,0.08);
  color: #fff;
}

.cta.secondary {
  background: rgba(255,255,255,0.08);
  color: #fff;
}

.cta.secondary:hover {
  background: rgba(255,255,255,0.12);
}

/* ---------- SYSTEM LINE ---------- */

.system-line {
  display: flex;
  justify-content: center;
  gap: 0.8rem;
  font-size: 0.95rem;
  color: rgba(255,255,255,0.75);
}

.arrow {
  opacity: 0.5;
}

/* ---------- TRANSITION ---------- */

.transition {
  max-width: 720px;
  margin: 0 auto 8rem;
  padding: 0 1.5rem;
  text-align: center;
}

.transition p {
  font-size: clamp(1.9rem, 3vw, 2.3rem);
  line-height: 1.25;
  color: rgba(255,255,255,0.9);
}

/* ---------- PROOF OF PULL ---------- */

.proof-pull {
  max-width: 820px;
  margin: 0 auto 10rem;
  padding: 0 1.5rem;
}

.proof-inner {
  text-align: center;
}

.proof-title {
  font-size: clamp(2.1rem, 4vw, 2.6rem);
  line-height: 1.15;
  margin-bottom: 1rem;
}

.proof-intro {
  color: rgba(255,255,255,0.65);
  margin-bottom: 3rem;
  font-size: 1.05rem;
}

/* ---------- TABS ---------- */

.proof-tabs {
  margin-top: 3rem;
}

.tab-controls {
  display: flex;
  gap: 1rem;
  justify-content: center;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 2.5rem;
}

.tab-btn {
  background: none;
  border: none;
  padding: 0.75rem 1rem;
  color: rgba(255,255,255,0.5);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.2s ease;
  font-size: 0.95rem;
}

.tab-btn.active {
  color: rgba(255,255,255,0.92);
  border-bottom-color: rgba(255,255,255,0.92);
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

/* ---------- FEEDBACK ---------- */

.feedback-list {
  display: grid;
  gap: 2rem;
  margin-bottom: 1.5rem;
  text-align: left;
}

.feedback-list blockquote {
  font-size: 1.15rem;
  line-height: 1.6;
  margin: 0;
  color: rgba(255,255,255,0.85);
  padding-left: 1.2rem;
  border-left: 2px solid rgba(255,255,255,0.15);
}

.feedback-label {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.45);
  font-weight: 500;
}

/* ---------- GATEWAYS ---------- */

.gateways {
  max-width: 960px;
  margin: 0 auto 10rem;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.5rem;
}

.gateway p {
  color: rgba(255,255,255,0.7);
  margin-bottom: 1.6rem;
}

/* ---------- QUOTE ---------- */

.quote {
  max-width: 720px;
  margin: 0 auto 10rem;
  padding: 0 1.5rem;
  text-align: center;
}

.quote p {
  font-size: clamp(1.9rem, 3vw, 2.3rem);
  color: rgba(255,255,255,0.92);
}

/* ---------- FINAL ---------- */

.final {
  max-width: 720px;
  margin: 0 auto 6rem;
  padding: 0 1.5rem;
  text-align: center;
}

.final p {
  color: rgba(255,255,255,0.65);
  margin-bottom: 2.4rem;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
  .gateways {
    grid-template-columns: 1fr;
  }

  .hero-ctas {
    flex-direction: column;
  }

  .cta-row {
    flex-direction: column;
    max-width: 300px;
    margin: 0 auto;
  }
}
</style>
