---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<!-- HERO -->
<section class="hero">
  <h1>
    Identity,<br />
    before algorithms.
  </h1>

  <p class="hero-sub">
    ETHOS is a system for understanding who you are —
    so decisions across life align and compound.
  </p>

  <div class="showcase">
    <div class="panel">Identity</div>
    <div class="panel">Signal</div>
    <div class="panel">Experience</div>
  </div>
</section>
<section class="hero">
  <h1 data-enter data-alive>
    Start with how you experience the world.
  </h1>

  <p data-enter="delay-2">
    ETHOS helps you align, not optimise.
  </p>

  <div data-enter="delay-3">
    <!-- CTA -->
  </div>
</section>

<!-- QUOTE -->
<section class="quote">
  <p>
    “It’s not about saving time.<br />
    It’s about never wasting it.”
  </p>

  <a
    href="https://discovery.ethos-official.com"
    class="cta"
    target="_blank"
    rel="noopener"
  >
    Discover your identity →
  </a>
</section>

<!-- INVESTOR -->
<section class="investor">
  <h2>
    Built for alignment.<br />
    Designed to compound.
  </h2>

  <p class="investor-sub">
    Explore the system and the thinking behind ETHOS.
  </p>

  <a href="/deck" class="cta secondary">
    View the deck →
  </a>
</section>

</BaseLayout>

<style>
  /* ---------- GLOBAL FEEL ---------- */

  :global(body) {
    background:
      radial-gradient(
        60% 40% at 50% 0%,
        rgba(255,255,255,0.06),
        rgba(0,0,0,0) 70%
      ),
      #000;
  }

  /* ---------- HERO ---------- */

  .hero {
    text-align: center;
    max-width: 820px;
    margin: 6rem auto 10rem;
    padding: 0 1.5rem;
  }

  h1 {
    font-size: clamp(3.4rem, 6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 1.75rem;
  }

  .hero-sub {
    max-width: 560px;
    margin: 0 auto 4rem;
    font-size: 1.15rem;
    color: rgba(255,255,255,0.72);
  }

  /* ---------- SHOWCASE (FIXED) ---------- */

  .showcase {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
  max-width: 640px;
  margin: 0 auto;
}

/* subtle animated aura */
.showcase::before {
  content: "";
  position: absolute;
  inset: -80px -40px;
  background:
    radial-gradient(
      40% 40% at 30% 50%,
      rgba(64, 132, 255, 0.18),
      rgba(0, 0, 0, 0) 70%
    ),
    radial-gradient(
      40% 40% at 70% 50%,
      rgba(64, 132, 255, 0.12),
      rgba(0, 0, 0, 0) 70%
    );
  filter: blur(60px);
  opacity: 0.9;
  animation: float 18s ease-in-out infinite alternate;
  pointer-events: none;
  z-index: 0;
}

@keyframes float {
  from {
    transform: translateY(-6px);
  }
  to {
    transform: translateY(6px);
  }
}

.panel {
  position: relative;
  z-index: 1;
  height: 88px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(120, 170, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(14px);
  transition:
    transform 240ms ease,
    background 240ms ease,
    border-color 240ms ease;
}

.panel:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(120, 170, 255, 0.35);
}

  /* ---------- QUOTE ---------- */

  .quote {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 12rem;
    padding: 0 1.5rem;
  }

  .quote p {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    line-height: 1.25;
    margin-bottom: 2.5rem;
    color: rgba(255,255,255,0.92);
  }

  /* ---------- CTA ---------- */

  .cta {
    display: inline-block;
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 500;
    font-size: 0.95rem;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .cta:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .cta.secondary {
    background: rgba(255,255,255,0.08);
    color: #fff;
  }

  /* ---------- INVESTOR ---------- */

  .investor {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 6rem;
    padding: 0 1.5rem;
  }

  .investor h2 {
    font-size: clamp(2.1rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .investor-sub {
    color: rgba(255,255,255,0.65);
    margin-bottom: 2.25rem;
  }
</style>
