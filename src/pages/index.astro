---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="
    max-width: 640px;
    padding-top: 4rem;
  ">
    <h1 style="
      font-size: 3.25rem;
      line-height: 1.05;
      letter-spacing: -0.035em;
      margin-bottom: 1.75rem;
      font-weight: 600;
    ">
      Identity,<br />before algorithms.
    </h1>

    <p style="
      font-size: 1.05rem;
      line-height: 1.65;
      color: #555;
      max-width: 560px;
    ">
      ETHOS is a system for understanding who you are,
      so decisions across life start to align — and compound.
    </p>
  </section>
</BaseLayout>
