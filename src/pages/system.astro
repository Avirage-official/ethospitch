---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="max-width: 760px;">
    <h1 style="
      font-size: 2.4rem;
      letter-spacing: -0.025em;
      margin-bottom: 1.5rem;
    ">
      A system, not a feed.
    </h1>

    <p style="
      font-size: 1.05rem;
      line-height: 1.65;
      color: #555;
      max-width: 680px;
      margin-bottom: 2.5rem;
    ">
      Most platforms optimize for engagement.
      ETHOS is built to optimize for fit.
    </p>

    <div style="
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 640px;
    ">
      <div>
        <strong>Identity</strong><br />
        <span style="color:#555">
          Understand how you think, decide, and relate before making choices.
        </span>
      </div>

      <div>
        <strong>Signal</strong><br />
        <span style="color:#555">
          Translate identity into clear preferences that guide discovery.
        </span>
      </div>

      <div>
        <strong>Experience</strong><br />
        <span style="color:#555">
          Discover people, places, and moments that align naturally.
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
