---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="system-root" id="ethos-system">

    <!-- 1) ENTRY -->
    <section class="stage entry">
      <div class="kicker">A quiet system for real alignment</div>
      <h1 class="headline">
        ETHOS helps you notice your patterns —
        <span class="soft">not label you.</span>
      </h1>
      <p class="subhead">
        We combine multiple lenses (without making it clinical) to give you a human profile you can actually use:
        where you thrive, how you recharge, what drains you, and what fits.
      </p>

      <div class="entry-actions">
        <button class="primary-cta" data-action="begin">
          Begin (2–3 minutes)
        </button>
        <button class="ghost-cta" data-action="scroll">
          See how it works ↓
        </button>
      </div>

      <div class="trust-row">
        <div class="pill">No feeds</div>
        <div class="pill">No ranking pressure</div>
        <div class="pill">No manipulation</div>
        <div class="pill">Built for calm people</div>
      </div>
    </section>

    <!-- 2) EXPERIENCE-BASED QUESTIONS (no frameworks named) -->
    <section class="stage experience" id="experience">
      <div class="section-title">
        <h2>Start with how you experience the world</h2>
        <p>One question at a time. No tricks. Just signal.</p>
      </div>

      <div class="panel">
        <div class="stepper">
          <span class="dot is-on"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>

        <div class="question" data-q="0">
          <h3>After social time, I usually feel…</h3>
          <div class="choices">
            <button class="choice" data-next="1" data-tag="recharge-alone">Drained — I need quiet</button>
            <button class="choice" data-next="1" data-tag="balanced">Neutral — depends</button>
            <button class="choice" data-next="1" data-tag="recharge-with-people">Energised — I want more</button>
          </div>
        </div>

        <div class="question hidden" data-q="1">
          <h3>When a place feels “too much”, it’s usually because…</h3>
          <div class="choices">
            <button class="choice" data-next="2" data-tag="stim-sensitive">Noise / crowds / intensity</button>
            <button class="choice" data-next="2" data-tag="unclear-energy">The vibe feels off</button>
            <button class="choice" data-next="2" data-tag="rigid-structure">It’s too structured / controlled</button>
          </div>
        </div>

        <div class="question hidden" data-q="2">
          <h3>I feel most like myself when I’m…</h3>
          <div class="choices">
            <button class="choice" data-next="dob" data-tag="depth">In depth — calm, meaningful</button>
            <button class="choice" data-next="dob" data-tag="movement">In motion — exploring, doing</button>
            <button class="choice" data-next="dob" data-tag="people">In connection — warm, shared</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 3) DOB (context, not fate) -->
    <section class="stage dob hidden" id="dob">
      <div class="section-title">
        <h2>Add timing (not fate)</h2>
        <p>Your date of birth helps us understand rhythm and tempo — not destiny.</p>
      </div>

      <div class="panel split">
        <div class="left">
          <label class="field">
            <span>Date of birth</span>
            <input type="date" id="dobInput" />
          </label>

          <button class="primary-cta" data-action="reveal" disabled id="revealBtn">
            Continue →
          </button>

          <div class="micro">
            We use it to shape pacing, cycles, and how you reset — not to predict your life.
          </div>
        </div>

        <div class="right card-glass">
          <div class="mini-title">What this unlocks</div>
          <ul class="mini-list">
            <li>Natural pace & energy rhythm</li>
            <li>Stress-response patterns</li>
            <li>Timing for social openness</li>
            <li>A more accurate profile blend</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 4) REVEAL -->
    <section class="stage reveal hidden" id="reveal">
      <div class="reveal-wrap">
        <div class="badge">Example profile</div>
        <h2 class="reveal-title">
          Your pattern is <span>Earthlistener</span>
        </h2>
        <p class="reveal-desc">
          Grounded. Environment-sensitive. Restored by calm and depth.
          You notice tone, texture, and emotional weather faster than most.
        </p>

        <div class="reveal-actions">
          <button class="primary-cta" data-action="dashboard">
            See your profile layers →
          </button>
          <button class="ghost-cta" data-action="skip-to-market">
            Jump to “how it works”
          </button>
        </div>
      </div>
    </section>

    <!-- 5) DASHBOARD LAYERS (frameworks hidden behind human language) -->
    <section class="stage dashboard hidden" id="dashboard">
      <div class="section-title">
        <h2>Your profile layers</h2>
        <p>Clear enough to use. Deep enough to feel true.</p>
      </div>

      <div class="grid-4">
        <div class="layer card-glass" data-enter>
          <div class="layer-top">
            <div class="icon">◌</div>
            <div class="layer-title">How you recharge</div>
          </div>
          <div class="layer-body">
            Quiet resets you. You come back sharper after stillness.
          </div>
          <button class="mini-cta" type="button">Learn more</button>
        </div>

        <div class="layer card-glass" data-enter="delay-1">
          <div class="layer-top">
            <div class="icon">⌁</div>
            <div class="layer-title">How you decide</div>
          </div>
          <div class="layer-body">
            You read patterns first, then commit once it feels coherent.
          </div>
          <button class="mini-cta" type="button">Learn more</button>
        </div>

        <div class="layer card-glass" data-enter="delay-2">
          <div class="layer-top">
            <div class="icon">∿</div>
            <div class="layer-title">Your natural pace</div>
          </div>
          <div class="layer-body">
            You move best with spacious time — not urgency.
          </div>
          <button class="mini-cta" type="button">Learn more</button>
        </div>

        <div class="layer card-glass" data-enter="delay-3">
          <div class="layer-top">
            <div class="icon">✶</div>
            <div class="layer-title">Your elemental lean</div>
          </div>
          <div class="layer-body">
            You stabilise environments. You’re a grounding presence.
          </div>
          <button class="mini-cta" type="button">Learn more</button>
        </div>
      </div>

      <div class="dash-foot">
        <div class="dash-note">
          Under the hood, ETHOS blends multiple frameworks — but you’ll only see what’s useful.
        </div>
        <button class="ghost-cta" data-action="market">
          Show me how this becomes real life ↓
        </button>
      </div>
    </section>

    <!-- 6) MARKETPLACE (illustration, not instruction) -->
    <section class="stage market hidden" id="market">
      <div class="section-title">
        <h2>Now you can curate life — gently</h2>
        <p>Not “go here.” More like: “here’s what tends to fit people like you.”</p>
      </div>

      <div class="market-hero card-glass">
        <div class="market-left">
          <div class="market-kicker">Near you</div>
          <div class="market-big">15 Earthlistener-aligned spots</div>
          <div class="market-sub">
            Calm environments. Low pressure. Places you’ll actually stay longer in.
          </div>
        </div>

        <div class="market-right">
          <div class="chips">
            <span class="chip">Quiet cafés</span>
            <span class="chip">Nature edges</span>
            <span class="chip">Soft lighting</span>
            <span class="chip">Low noise</span>
            <span class="chip">Slow pace</span>
          </div>
        </div>
      </div>

      <div class="cards-3">
        <div class="card card-tilt">
          <div class="card-top">Experiences</div>
          <div class="card-title">Aligned moments</div>
          <div class="card-desc">You explore without being pushed.</div>
        </div>
        <div class="card card-tilt">
          <div class="card-top">People</div>
          <div class="card-title">Energy-aware connection</div>
          <div class="card-desc">Meet others without performance.</div>
        </div>
        <div class="card card-tilt">
          <div class="card-top">Choices</div>
          <div class="card-title">A life compass</div>
          <div class="card-desc">Career, health, creativity — later layers.</div>
        </div>
      </div>

      <button class="primary-cta center" data-action="mood">
        Show me the mood layer →
      </button>
    </section>

    <!-- 7) MOOD LAYER (consent-aware, not defensive) -->
    <section class="stage mood hidden" id="mood">
      <div class="section-title">
        <h2>How open are you today?</h2>
        <p>This sets the tone for connection — softly, without drama.</p>
      </div>

      <div class="mood-panel card-glass">
        <div class="mood-choices">
          <button class="mood-btn" data-mood="closed">
            <span class="mood-title">Closed</span>
            <span class="mood-desc">Quiet day. Minimal signals.</span>
          </button>

          <button class="mood-btn is-on" data-mood="neutral">
            <span class="mood-title">Neutral</span>
            <span class="mood-desc">Open to small moments.</span>
          </button>

          <button class="mood-btn" data-mood="open">
            <span class="mood-title">Open</span>
            <span class="mood-desc">Good day to connect.</span>
          </button>
        </div>

        <div class="mood-status">
          <div class="status-line">
            Today’s signal: <span id="moodValue">Neutral</span>
          </div>
          <div class="status-sub">
            ETHOS adjusts visibility, invites, and expectations — without turning you into content.
          </div>
        </div>
      </div>

      <button class="ghost-cta center" data-action="closing">
        Wrap it up ↓
      </button>
    </section>

    <!-- 8) CLOSING -->
    <section class="stage closing hidden" id="closing">
      <div class="closing-wrap">
        <div class="badge">More coming</div>
        <h2>Do you understand ETHOS now?</h2>
        <p>
          This is only the start. Next, ETHOS expands into health, career, creativity, and direction —
          always guided by your pattern.
        </p>

        <div class="closing-actions">
          <button class="primary-cta">Continue at your own pace →</button>
          <button class="ghost-cta">Back to top</button>
        </div>
      </div>
    </section>

  </section>
</BaseLayout>

<script>
  /* ===========================
     ETHOS SYSTEM FLOW CONTROLLER
     =========================== */

  // stage-in on scroll (2026 standard)
  const stages = document.querySelectorAll(".system-root > .stage");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.15 }
  );
  stages.forEach((s) => io.observe(s));

  // entry buttons
  const beginBtn = document.querySelector('[data-action="begin"]');
  const scrollBtn = document.querySelector('[data-action="scroll"]');

  beginBtn?.addEventListener("click", () => {
    document.getElementById("experience")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  scrollBtn?.addEventListener("click", () => {
    document.getElementById("experience")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // question flow
  const panel = document.querySelector(".experience .panel");
  const dots = document.querySelectorAll(".experience .dot");
  const questions = document.querySelectorAll(".experience .question");

  function setDot(i) {
    dots.forEach((d, idx) => d.classList.toggle("is-on", idx === i));
  }

  function showQuestion(i) {
    questions.forEach((q) => q.classList.add("hidden"));
    const el = document.querySelector(`.experience .question[data-q="${i}"]`);
    el?.classList.remove("hidden");
    el?.classList.add("pop");
    setTimeout(() => el?.classList.remove("pop"), 380);
    setDot(i);
  }

  document.querySelectorAll(".choice").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.getAttribute("data-next");

      if (next === "dob") {
        document.getElementById("dob")?.classList.remove("hidden");
        document.getElementById("dob")?.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }

      const nextIndex = Number(next);
      showQuestion(nextIndex);
    });
  });

  // enable reveal when DOB chosen
  const dobInput = document.getElementById("dobInput");
  const revealBtn = document.getElementById("revealBtn");

  dobInput?.addEventListener("input", () => {
    revealBtn.disabled = !dobInput.value;
  });

  // stage actions
  function go(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove("hidden");
    el.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  document.querySelector('[data-action="reveal"]')?.addEventListener("click", () => go("reveal"));
  document.querySelector('[data-action="dashboard"]')?.addEventListener("click", () => go("dashboard"));
  document.querySelector('[data-action="skip-to-market"]')?.addEventListener("click", () => go("market"));
  document.querySelector('[data-action="market"]')?.addEventListener("click", () => go("market"));
  document.querySelector('[data-action="mood"]')?.addEventListener("click", () => go("mood"));
  document.querySelector('[data-action="closing"]')?.addEventListener("click", () => go("closing"));

  // mood selector
  const moodValue = document.getElementById("moodValue");
  document.querySelectorAll(".mood-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".mood-btn").forEach((b) => b.classList.remove("is-on"));
      btn.classList.add("is-on");

      const mood = btn.getAttribute("data-mood");
      if (mood === "closed") moodValue.textContent = "Closed";
      if (mood === "neutral") moodValue.textContent = "Neutral";
      if (mood === "open") moodValue.textContent = "Open";
    });
  });

  // back to top
  document.querySelector(".closing .ghost-cta")?.addEventListener("click", () => {
    document.getElementById("ethos-system")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>

<style>
  /* ===========================
     LAYOUT
     =========================== */

  .system-root {
    padding: 6rem 1.5rem 10rem;
  }

  .stage {
    margin: 0 auto 8rem;
    max-width: 980px;
  }

  /* 2026 staging motion */
  .system-root > .stage {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(6px);
    transition:
      opacity 900ms cubic-bezier(0.22,1,0.36,1),
      transform 900ms cubic-bezier(0.22,1,0.36,1),
      filter 900ms cubic-bezier(0.22,1,0.36,1);
  }
  .system-root > .stage.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* ===========================
     TYPOGRAPHY
     =========================== */

  .kicker {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .headline {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.05;
    margin: 0 0 1.2rem;
    letter-spacing: -0.03em;
  }

  .headline .soft {
    color: rgba(255,255,255,0.72);
    font-weight: 500;
  }

  .subhead {
    font-size: 1.1rem;
    max-width: 760px;
    color: rgba(255,255,255,0.72);
    line-height: 1.7;
  }

  .section-title {
    text-align: center;
    margin: 0 auto 2.5rem;
    max-width: 760px;
  }

  .section-title h2 {
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    margin: 0 0 0.8rem;
    letter-spacing: -0.03em;
  }

  .section-title p {
    margin: 0;
    color: rgba(255,255,255,0.7);
  }

  /* ===========================
     UI PRIMITIVES
     =========================== */

  .card-glass {
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 24px;
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 30px 80px -40px rgba(0,0,0,0.9);
  }

  .primary-cta {
    padding: 0.95rem 1.3rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 600;
    border: 0;
    cursor: pointer;
    transition: transform 180ms ease, filter 180ms ease;
  }
  .primary-cta:hover { transform: translateY(-1px); }
  .primary-cta:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .ghost-cta {
    padding: 0.95rem 1.3rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.92);
    font-weight: 520;
    cursor: pointer;
    transition: transform 180ms ease;
  }
  .ghost-cta:hover { transform: translateY(-1px); }

  .center { display: block; margin: 2.5rem auto 0; }

  .badge {
    display: inline-flex;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.76);
    font-size: 0.85rem;
  }

  /* ===========================
     ENTRY
     =========================== */

  .entry-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 2rem 0 1.6rem;
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  .pill {
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
  }

  /* ===========================
     EXPERIENCE Qs
     =========================== */

  .panel {
    max-width: 860px;
    margin: 0 auto;
    padding: 1.25rem;
    border-radius: 28px;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(16px);
  }

  .stepper {
    display: flex;
    gap: 8px;
    justify-content: center;
    padding: 0.6rem 0 1rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(255,255,255,0.18);
  }
  .dot.is-on {
    background: rgba(120,170,255,0.85);
    box-shadow: 0 0 0 6px rgba(120,170,255,0.12);
  }

  .question {
    padding: 1.2rem 1.2rem 0.6rem;
  }

  .question h3 {
    font-size: 1.6rem;
    margin: 0 0 1.2rem;
    letter-spacing: -0.02em;
  }

  .choices {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  .choice {
    text-align: left;
    padding: 1rem 1.1rem;
    border-radius: 18px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(120,170,255,0.18);
    color: rgba(255,255,255,0.92);
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease;
  }
  .choice:hover {
    transform: translateY(-1px);
    border-color: rgba(120,170,255,0.35);
  }

  .pop { animation: pop 380ms cubic-bezier(0.22,1,0.36,1); }
  @keyframes pop {
    from { transform: translateY(10px); opacity: 0.3; filter: blur(4px); }
    to   { transform: translateY(0); opacity: 1; filter: blur(0); }
  }

  /* ===========================
     DOB
     =========================== */

  .split {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: start;
    padding: 1.2rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .field span {
    color: rgba(255,255,255,0.75);
    font-size: 0.95rem;
  }

  input[type="date"] {
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(0,0,0,0.25);
    color: rgba(255,255,255,0.92);
    outline: none;
  }

  .micro {
    margin-top: 0.8rem;
    color: rgba(255,255,255,0.62);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .mini-title {
    font-weight: 650;
    margin-bottom: 0.8rem;
    color: rgba(255,255,255,0.9);
  }

  .mini-list {
    margin: 0;
    padding-left: 1.1rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.8;
  }

  /* ===========================
     REVEAL
     =========================== */

  .reveal-wrap {
    text-align: center;
    max-width: 840px;
    margin: 0 auto;
  }

  .reveal-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 1rem 0 0.8rem;
    letter-spacing: -0.03em;
  }

  .reveal-title span {
    color: rgba(120,170,255,0.95);
  }

  .reveal-desc {
    margin: 0 auto;
    max-width: 720px;
    color: rgba(255,255,255,0.72);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .reveal-actions {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* ===========================
     DASHBOARD
     =========================== */

  .grid-4 {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .layer {
    padding: 1.1rem 1.1rem 1rem;
  }

  .layer-top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
  }

  .icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(120,170,255,0.12);
    border: 1px solid rgba(120,170,255,0.22);
    color: rgba(120,170,255,0.95);
    font-weight: 700;
  }

  .layer-title {
    font-weight: 700;
    color: rgba(255,255,255,0.92);
  }

  .layer-body {
    color: rgba(255,255,255,0.72);
    line-height: 1.6;
    min-height: 66px;
  }

  .mini-cta {
    margin-top: 1rem;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.85);
    cursor: pointer;
  }

  .dash-foot {
    margin-top: 1.6rem;
    text-align: center;
  }

  .dash-note {
    color: rgba(255,255,255,0.65);
    max-width: 760px;
    margin: 0 auto 1.2rem;
    line-height: 1.7;
  }

  /* ===========================
     MARKET
     =========================== */

  .market-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.2rem;
    padding: 1.2rem;
    margin: 0 auto 1.2rem;
    max-width: 920px;
  }

  .market-kicker {
    color: rgba(255,255,255,0.65);
    text-transform: uppercase;
