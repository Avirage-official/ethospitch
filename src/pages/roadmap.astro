---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="
    max-width: 760px;
    padding-top: 4rem;
  ">
    <h1 style="
      font-size: 2.4rem;
      letter-spacing: -0.025em;
      margin-bottom: 1.5rem;
    ">
      Roadmap.
    </h1>

    <p style="
      font-size: 0.95rem;
      color: var(--text-secondary);
      max-width: 640px;
      margin-bottom: 3rem;
    ">
      Built deliberately. Each phase proves clarity before scale.
    </p>

    <div style="
      display: grid;
      gap: 2.5rem;
      max-width: 640px;
    ">
      <div>
        <strong>Phase 1 — Signal</strong>
        <p style="margin-top: 0.5rem;">
          Validate identity patterns and repeat resonance with real users.
        </p>
      </div>

      <div>
        <strong>Phase 2 — Expansion</strong>
        <p style="margin-top: 0.5rem;">
          Extend into new domains without diluting signal quality.
        </p>
      </div>

      <div>
        <strong>Phase 3 — Infrastructure</strong>
        <p style="margin-top: 0.5rem;">
          Establish ETHOS as a persistent identity layer across decisions.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
