---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="roadmap-root">

    <!-- INTRO -->
    <header class="roadmap-intro">
      <h1>Roadmap</h1>
      <p>
        ETHOS is not built on timelines.<br />
        It is built on proof.
      </p>
    </header>

    <!-- ROADMAP FIELD -->
    <section class="roadmap-field">

      <!-- PATH -->
      <svg
        class="road-path"
        viewBox="0 0 1000 1200"
        preserveAspectRatio="none"
      >
        <path
          d="M500 0
             C480 200, 520 300, 500 420
             C480 560, 520 660, 500 780
             C480 940, 520 1040, 500 1200"
          fill="none"
          stroke="rgba(120,170,255,0.35)"
          stroke-width="2"
          stroke-dasharray="6 10"
        />
      </svg>

      <!-- PHASE 1 -->
      <article class="phase phase-1">
        <span class="phase-tag">Phase 1</span>
        <h2>Signal integrity</h2>
        <p>
          Prove identity stability before expansion.
          Signal must hold across repetition and context.
        </p>
        <ul>
          <li>Identity discovery experience</li>
          <li>Core code stability</li>
          <li>Early aligned experiences</li>
        </ul>
      </article>

      <!-- PHASE 2 -->
      <article class="phase phase-2">
        <span class="phase-tag">Phase 2</span>
        <h2>Domain expansion</h2>
        <p>
          Extend ETHOS across life domains
          without diluting signal quality.
        </p>
        <ul>
          <li>People & social alignment</li>
          <li>Work & collaboration</li>
          <li>Places & environments</li>
        </ul>
      </article>

      <!-- PHASE 3 -->
      <article class="phase phase-3">
        <span class="phase-tag">Phase 3</span>
        <h2>Infrastructure</h2>
        <p>
          Establish ETHOS as a persistent
          identity layer across decisions.
        </p>
        <ul>
          <li>Cross-platform identity layer</li>
          <li>Partner integrations</li>
          <li>Long-term signal compounding</li>
        </ul>
      </article>

    </section>

    <!-- CLOSE -->
    <footer class="roadmap-close">
      <p>
        ETHOS does not chase growth.<br />
        It earns it by preserving clarity.
      </p>
    </footer>

  </section>
</BaseLayout>

<style>
/* ROOT */
.roadmap-root {
  padding: 6rem 1.5rem 10rem;
}

/* INTRO */
.roadmap-intro {
  max-width: 760px;
  margin: 0 auto 8rem;
  text-align: center;
}
.roadmap-intro h1 {
  font-size: 3.2rem;
  letter-spacing: -0.03em;
  margin-bottom: 1.2rem;
}
.roadmap-intro p {
  color: rgba(255,255,255,0.7);
  font-size: 1.1rem;
}

/* FIELD */
.roadmap-field {
  position: relative;
  max-width: 900px;
  margin: 0 auto 8rem;
  min-height: 1200px;
}

/* PATH */
.road-path {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 0.6;
}

/* PHASES */
.phase {
  position: relative;
  max-width: 420px;
  margin-bottom: 14rem;
  padding: 2rem 2.2rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(120,170,255,0.22);
  border-radius: 24px;
  backdrop-filter: blur(16px);
  z-index: 1;
  animation: rise 1s ease forwards;
}

.phase-1 {
  margin-left: 0;
}
.phase-2 {
  margin-left: auto;
}
.phase-3 {
  margin-left: 0;
}

.phase-tag {
  display: inline-block;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(120,170,255,0.8);
  margin-bottom: 0.6rem;
}

.phase h2 {
  font-size: 1.6rem;
  margin-bottom: 0.75rem;
}

.phase p {
  color: rgba(255,255,255,0.75);
  margin-bottom: 1.2rem;
}

.phase ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.phase li {
  position: relative;
  padding-left: 1.2rem;
  margin-bottom: 0.5rem;
  color: rgba(255,255,255,0.7);
}

.phase li::before {
  content: "•";
  position: absolute;
  left: 0;
  color: rgba(120,170,255,0.7);
}

/* ANIMATION */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(80px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* CLOSE */
.roadmap-close {
  max-width: 560px;
  margin: 0 auto;
  text-align: center;
  color: rgba(255,255,255,0.7);
}
</style>
