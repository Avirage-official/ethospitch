---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section style="max-width: 760px; padding-top: 4rem;">
    <h1 style="
      font-size: 2.8rem;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
    ">
      Roadmap.
    </h1>

    <p style="
      font-size: 1.1rem;
      line-height: 1.6;
      max-width: 640px;
      margin-bottom: 3.5rem;
    ">
      ETHOS is built deliberately.
      Each phase proves signal before scale.
    </p>

    <!-- Phase 1 -->
    <div style="
      border-top: 1px solid var(--border-subtle);
      padding-top: 2.5rem;
      margin-bottom: 3rem;
      max-width: 680px;
    ">
      <strong>Phase 1 — Signal integrity</strong>
      <p style="margin-top: 0.75rem;">
        Validate identity models through repeated use.
        Measure resonance, stability, and decision confidence.
      </p>
      <ul style="margin-top: 1rem; padding-left: 1rem;">
        <li>Identity discovery experience</li>
        <li>Core code stability</li>
        <li>Early aligned experiences</li>
      </ul>
    </div>

    <!-- Phase 2 -->
    <div style="
      border-top: 1px solid var(--border-subtle);
      padding-top: 2.5rem;
      margin-bottom: 3rem;
      max-width: 680px;
    ">
      <strong>Phase 2 — Domain expansion</strong>
      <p style="margin-top: 0.75rem;">
        Extend ETHOS into new life domains
        without diluting signal quality.
      </p>
      <ul style="margin-top: 1rem; padding-left: 1rem;">
        <li>People and social alignment</li>
        <li>Work and collaboration</li>
        <li>Places and environments</li>
      </ul>
    </div>

    <!-- Phase 3 -->
    <div style="
      border-top: 1px solid var(--border-subtle);
      padding-top: 2.5rem;
      margin-bottom: 3rem;
      max-width: 680px;
    ">
      <strong>Phase 3 — Infrastructure</strong>
      <p style="margin-top: 0.75rem;">
        Establish ETHOS as a persistent
        identity layer across decisions.
      </p>
      <ul style="margin-top: 1rem; padding-left: 1rem;">
        <li>Cross-platform identity layer</li>
        <li>Partner integrations</li>
        <li>Long-term signal compounding</li>
      </ul>
    </div>

    <!-- Closing -->
    <div style="
      border-top: 1px solid var(--border-subtle);
      padding-top: 3rem;
      max-width: 560px;
    ">
      <p>
        ETHOS does not chase growth.
        It earns it by preserving clarity.
      </p>
    </div>
  </section>
</BaseLayout>
