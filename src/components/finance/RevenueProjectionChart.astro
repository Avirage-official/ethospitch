---
/**
 * RevenueProjectionChart
 * Investor-grade animated revenue projection
 * Pure SVG + CSS (no JS libs)
 */

const data = [
  { label: "Year 1", value: 150 },
  { label: "Year 2", value: 600 },
  { label: "Year 3", value: 1700 },
];

const max = Math.max(...data.map(d => d.value));
---

<div class="chart-root">
  <svg viewBox="0 0 420 260" preserveAspectRatio="none">
    <!-- GRID -->
    <g class="grid">
      <line x1="0" y1="200" x2="420" y2="200" />
      <line x1="0" y1="140" x2="420" y2="140" />
      <line x1="0" y1="80" x2="420" y2="80" />
    </g>

    <!-- BARS -->
    {data.map((d, i) => {
      const height = (d.value / max) * 160;
      const x = 60 + i * 120;
      const y = 200 - height;
      return (
        <g class="bar-group" style={`--h:${height}px;--delay:${i * 200}ms`}>
          <rect
            x={x}
            y={200}
            width="48"
            height={height}
            rx="10"
            class="bar"
          />
          <text x={x + 24} y={y - 10} text-anchor="middle" class="value">
            ${d.value >= 1000 ? `${(d.value / 1000).toFixed(1)}M` : `${d.value}k`}
          </text>
          <text x={x + 24} y="230" text-anchor="middle" class="label">
            {d.label}
          </text>
        </g>
      );
    })}
  </svg>

  <div class="caption">
    Conservative revenue projection based on business subscriptions only.
  </div>
</div>

<style>
.chart-root {
  margin-top: 3rem;
}

svg {
  width: 100%;
  height: 260px;
}

/* GRID */
.grid line {
  stroke: rgba(255,255,255,0.08);
  stroke-dasharray: 4 6;
}

/* BARS */
.bar {
  fill: url(#grad);
  animation: grow 900ms cubic-bezier(0.22,1,0.36,1) forwards;
  animation-delay: var(--delay);
  transform-origin: bottom;
  transform: scaleY(0);
}

.bar-group {
  --grad-start: #7aa7ff;
  --grad-end: #4f7cff;
}

svg defs {
  display: none;
}

.value {
  fill: rgba(255,255,255,0.9);
  font-size: 12px;
  opacity: 0;
  animation: fadeIn 600ms ease forwards;
  animation-delay: calc(var(--delay) + 600ms);
}

.label {
  fill: rgba(255,255,255,0.65);
  font-size: 11px;
}

/* CAPTION */
.caption {
  margin-top: 1rem;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

/* ANIMATIONS */
@keyframes grow {
  to {
    transform: scaleY(1);
  }
}

@keyframes fadeIn {
  to {
    opacity: 1;
  }
}
</style>
