---
const points = [
  { x: 0, y: 150, label: "$150k" },
  { x: 1, y: 600, label: "$600k" },
  { x: 2, y: 1700, label: "$1.7M" },
];

const maxY = 1800;
---

<div class="chart-shell">
  <svg viewBox="0 0 600 260" aria-hidden="true">
    <defs>
      <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#6ea8ff" />
        <stop offset="100%" stop-color="#9fd0ff" />
      </linearGradient>

      <filter id="softGlow">
        <feGaussianBlur stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- GRID (VERY LIGHT) -->
    <g class="grid">
      <line x1="60" y1="200" x2="560" y2="200"/>
      <line x1="60" y1="140" x2="560" y2="140"/>
      <line x1="60" y1="80" x2="560" y2="80"/>
    </g>

    <!-- LINE -->
    <path
      d="
        M 80 200
        L 300 140
        L 520 60
      "
      class="line"
    />

    <!-- POINTS -->
    <g class="points">
      <circle cx="80" cy="200" r="5"/>
      <circle cx="300" cy="140" r="5"/>
      <circle cx="520" cy="60" r="5"/>
    </g>

    <!-- VALUES -->
    <g class="labels">
      <text x="80" y="184">$150k</text>
      <text x="300" y="124">$600k</text>
      <text x="520" y="44">$1.7M</text>
    </g>
  </svg>

  <p class="caption">
    Conservative projection based on subscription revenue only.
  </p>
</div>

<style>
.chart-shell {
  max-width: 760px;
  margin-top: 3rem;
}

/* SVG */
svg {
  width: 100%;
  height: auto;
  aspect-ratio: 600 / 260;
}

/* GRID */
.grid line {
  stroke: rgba(255,255,255,0.06);
  stroke-dasharray: 4 10;
}

/* LINE */
.line {
  fill: none;
  stroke: url(#lineGrad);
  stroke-width: 2.5;
  stroke-linecap: round;
  filter: url(#softGlow);

  stroke-dasharray: 800;
  stroke-dashoffset: 800;
  animation: draw 1.4s cubic-bezier(0.22,1,0.36,1) forwards;
}

/* POINTS */
.points circle {
  fill: #9fd0ff;
  opacity: 0;
  animation: pop 0.4s ease forwards;
}

.points circle:nth-child(1) { animation-delay: 0.6s; }
.points circle:nth-child(2) { animation-delay: 0.9s; }
.points circle:nth-child(3) { animation-delay: 1.2s; }

/* LABELS */
.labels text {
  fill: rgba(255,255,255,0.85);
  font-size: 12px;
  opacity: 0;
  animation: fade 0.4s ease forwards;
}

.labels text:nth-child(1) { animation-delay: 0.7s; }
.labels text:nth-child(2) { animation-delay: 1s; }
.labels text:nth-child(3) { animation-delay: 1.3s; }

/* CAPTION */
.caption {
  margin-top: 1.2rem;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

/* ANIMATIONS */
@keyframes draw {
  to { stroke-dashoffset: 0; }
}

@keyframes pop {
  to { opacity: 1; }
}

@keyframes fade {
  to { opacity: 1; }
}
</style>
