---
/**
 * ETHOS Atmosphere — Directional Tech Field
 * Serious • Optimistic • Forward-motion
 */
---

<div class="atmosphere">
  <div class="beams"></div>
  <div class="glow"></div>
  <div class="noise"></div>
</div>

<style>
  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: #000;
    overflow: hidden;
  }

  /* Diagonal light beams (core identity) */
  .beams {
    position: absolute;
    inset: -20%;
    background:
      repeating-linear-gradient(
        115deg,
        rgba(255,255,255,0.06) 0px,
        rgba(255,255,255,0.06) 2px,
        rgba(255,255,255,0.0) 120px,
        rgba(255,255,255,0.0) 240px
      );
    filter: blur(60px);
    opacity: 0.55;
    animation: drift 40s linear infinite;
    mask-image: radial-gradient(
      ellipse at center,
      rgba(0,0,0,1) 30%,
      rgba(0,0,0,0) 70%
    );
  }

  /* Soft directional optimism */
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 40% at 50% 30%,
        rgba(80,140,255,0.18),
        transparent 70%
      ),
      radial-gradient(
        50% 30% at 70% 60%,
        rgba(140,110,255,0.12),
        transparent 70%
      );
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-240px);
    }
  }

  /* Grain = credibility */
  .noise {
    position: absolute;
    inset: 0;
    background-image: url("/noise.png");
    opacity: 0.045;
  }
</style>
